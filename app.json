{
  "expo": {
    "name": "Ýolbelet",
    "slug": "yolbelet-app",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d3557"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menli.yolbeletapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ýolbelet siziň ýoluňyzy yzarlamak üçin GPS ulanmaly.",
        "NSLocationAlwaysUsageDescription": "Ýolbelet siziň ýoluňyzy arka fonda hem yzarlap biler."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1d3557"
      },
      "package": "com.menli.yolbeletapp",
      "jsEngine": "hermes",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.SEND_SMS",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "6801fb20-7da6-4e60-ba07-3741d7c34738"
      }
    },
    "owner": "mengli"
  }
}
