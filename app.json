{
  "expo": {
    "name": "Yolbelet",
    "slug": "yolbelet-app",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d3557"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menli.yolbeletapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yolbelet programmasy ýoluňyzy karta ýazgy etmek üçin GPS ulanýar.",
        "NSLocationAlwaysUsageDescription": "Programma arka planda hem ýoluňyzy yzarlamak üçin hemişelik GPS rugsady gerek."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1d3557"
      },
      "package": "com.menli.yolbeletapp",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "SEND_SMS",
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a50a9d81-3da9-4dcc-a2fc-4a4001efb3c2" 
      }
    }
  }
}
